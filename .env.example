# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AskMira
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────────────────────
# Supabase gives you the Postgres connection string under
# Project Settings → Database → Connection string → URI.
# Use the *session pooler* (port 5432) host for migrations and the
# *transaction pooler* (port 6543) for the app if you deploy serverless.
#
# Async driver for the app (note the +asyncpg):
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Sync driver for Alembic (note the +psycopg2). Same database, different driver.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Auth ────────────────────────────────────────────────────────────────────
# We mint and verify our own JWTs. Supabase Auth is NOT used, so the Supabase
# anon key is deliberately absent from this file. (The service-role key under
# File storage is for Storage only.)
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-64-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2id parameters. Raise TIME_COST/MEMORY_COST on production hardware.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File storage ────────────────────────────────────────────────────────────
# Uploaded and generated files (document vault, letters, filings, resumes,
# tax proofs, bills). A deployment uses "supabase": a container's own disk is
# gone on the next deploy. "local" writes under FILE_STORAGE_ROOT, default
# backend/uploads, and suits development.
STORAGE_BACKEND=local
FILE_STORAGE_ROOT=
# Project Settings -> API. The service-role key bypasses Row Level Security:
# server only, never in the frontend, never committed. The bucket is private
# and is created by scripts/copy_uploads_to_supabase.py if it is missing.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=askmira-files

# ── AI (V2+, Anthropic Claude API) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
